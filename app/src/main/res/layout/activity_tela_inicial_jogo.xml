<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".TelaInicialJogo">

    <!-- JOGADOR 1 HEADER -->
    <TextView
        android:id="@+id/tvJogador1Header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Jogador 1: 00" />

    <!-- JOGADOR 1 BOTOES (+1, +3, +6, +9, +12) -->
    <Button
        android:id="@+id/btnP1Plus1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/btn_mais_1"
        app:layout_constraintEnd_toStartOf="@+id/btnP1Plus3"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvJogador1Header" />

    <Button
        android:id="@+id/btnP1Plus3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="@string/btn_mais_3"
        app:layout_constraintEnd_toStartOf="@+id/btnP1Plus6"
        app:layout_constraintStart_toEndOf="@id/btnP1Plus1"
        app:layout_constraintTop_toTopOf="@id/btnP1Plus1" />

    <Button
        android:id="@+id/btnP1Plus6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="@string/btn_mais_6"
        app:layout_constraintEnd_toStartOf="@+id/btnP1Plus9"
        app:layout_constraintStart_toEndOf="@id/btnP1Plus3"
        app:layout_constraintTop_toTopOf="@id/btnP1Plus1" />

    <Button
        android:id="@+id/btnP1Plus9"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="@string/btn_mais_9"
        app:layout_constraintEnd_toStartOf="@+id/btnP1Plus12"
        app:layout_constraintStart_toEndOf="@id/btnP1Plus6"
        app:layout_constraintTop_toTopOf="@id/btnP1Plus1" />

    <Button
        android:id="@+id/btnP1Plus12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_mais_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnP1Plus9"
        app:layout_constraintTop_toTopOf="@id/btnP1Plus1" />

    <!-- JOGADOR 2 HEADER -->
    <TextView
        android:id="@+id/tvJogador2Header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnP1Plus1"
        tools:text="Jogador 2: 00" />

    <!-- JOGADOR 2 BOTOES (+1, +3, +6, +9, +12) -->
    <Button
        android:id="@+id/btnP2Plus1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/btn_mais_1"
        app:layout_constraintEnd_toStartOf="@+id/btnP2Plus3"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvJogador2Header" />

    <Button
        android:id="@+id/btnP2Plus3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="@string/btn_mais_3"
        app:layout_constraintEnd_toStartOf="@+id/btnP2Plus6"
        app:layout_constraintStart_toEndOf="@id/btnP2Plus1"
        app:layout_constraintTop_toTopOf="@id/btnP2Plus1" />

    <Button
        android:id="@+id/btnP2Plus6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="@string/btn_mais_6"
        app:layout_constraintEnd_toStartOf="@+id/btnP2Plus9"
        app:layout_constraintStart_toEndOf="@id/btnP2Plus3"
        app:layout_constraintTop_toTopOf="@id/btnP2Plus1" />

    <Button
        android:id="@+id/btnP2Plus9"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="@string/btn_mais_9"
        app:layout_constraintEnd_toStartOf="@+id/btnP2Plus12"
        app:layout_constraintStart_toEndOf="@id/btnP2Plus6"
        app:layout_constraintTop_toTopOf="@id/btnP2Plus1" />

    <Button
        android:id="@+id/btnP2Plus12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_mais_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnP2Plus9"
        app:layout_constraintTop_toTopOf="@id/btnP2Plus1" />

    <!-- BOTOES DE ACAO (COLUNA ESQUERDA) -->
    <Button
        android:id="@+id/btnHistJogadas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/btn_hist_jogadas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnP2Plus1" />

    <Button
        android:id="@+id/btnZerarHistorico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_zerar_historico"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnHistJogadas" />

    <Button
        android:id="@+id/btnInfNomes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_inf_nomes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnZerarHistorico" />

</androidx.constraintlayout.widget.ConstraintLayout>